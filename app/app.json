{
  "expo": {
    "name": "WeatherGPT",
    "slug": "weathergpt-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B1220",
    "scheme": "weathergpt",
    "platforms": [
      "android",
      "web"
    ],
    "android": {
      "package": "com.weathergpt.weathergpt_mobile",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-font",
      "expo-location",
      "expo-speech-recognition",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "WeatherGPT uses the microphone so you can ask weather questions by voice."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
