# WeatherGPT Mobile configuration (React Native / Expo)
# The app renders and requests; the backend owns provider selection, keys and
# authorization. This is the only configuration value the app needs.

# Backend base URL. Defaults to the Android emulator's host loopback when
# unset; release builds must point at the deployed backend explicitly.

# Android Emulator (default):
EXPO_PUBLIC_BACKEND_URL=http://10.0.2.2:8888

# Local machine / web preview:
# EXPO_PUBLIC_BACKEND_URL=http://localhost:8888

# Physical Android device over Wi-Fi:
# EXPO_PUBLIC_BACKEND_URL=http://192.168.1.100:8888

# Shared secret the backend requires (its BACKEND_SECRET), sent as X-Backend-Secret.
# Must match the server exactly or every request is refused; leave empty when the
# backend has no BACKEND_SECRET. CI fills it from the BACKEND_SECRET repository
# secret. Never commit a real value.
# EXPO_PUBLIC_BACKEND_SECRET=
