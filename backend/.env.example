# --- WeatherGPT Shared Backend Configuration ---
# LLM Agent (Groq Cloud)
# Optional: enables the Groq/LangGraph reasoning path. Leave blank for telemetry-only chat.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Weather Provider Priority: IMD (when configured) -> AccuWeather -> Open-Meteo fallback
WEATHER_PROVIDER_PRIORITY=imd,accuweather,open_meteo

# AccuWeather API Key (Optional, free tier 50 req/day)
# ACCUWEATHER_KEY=your_accuweather_key_here

# IMD scaffolding only: even valid credentials cannot fetch until the adapter is implemented.
# IMD (India Meteorological Department) Credentials (Optional)
# IMD_API_KEY=your_imd_api_key_here
# IMD_JWT_TOKEN=your_imd_jwt_token_here

# Diagnostic Legacy Fusion Providers (Optional)
# WEATHERAPI_KEY=your_weatherapi_key_here
# TOMORROW_KEY=your_tomorrow_key_here
# OPENWEATHER_KEY=your_openweather_key_here

# Optional request/secondary-data controls
CHAT_TIMEOUT_SECONDS=22
CHAT_FAST_PATH=1
WEATHER_SUPPLEMENT_ENABLED=1
